{
  "name": "game-site-foundation",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "run-p dev:astro dev:cms-admin dev:cms-proxy",
    "dev:astro": "astro dev --host 127.0.0.1 --port 4321",
    "dev:cms-admin": "npm --prefix apps/cms-admin run dev",
    "dev:cms-proxy": "cross-env BIND_HOST=127.0.0.1 ORIGIN=http://127.0.0.1:4322 decap-server",
    "build": "astro build",
    "build:production": "astro build --mode production",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run --no-file-parallelism --exclude=tests/e2e/**",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:production-config": "node scripts/verify-production-config.mjs",
    "verify:development-config": "node scripts/verify-development-placeholder.mjs --validator scripts/verify-production-config.mjs",
    "game:validate": "node scripts/validate-game-package.mjs",
    "deploy:dry": "npm run deploy:production:dry",
    "deploy": "npm run deploy:production",
    "deploy:production:dry": "npm run format:check && npm run check && npm run test && npm run build:production && npm run verify:dist && npm run test:e2e && npm run verify:production-config && npx wrangler deploy --dry-run",
    "deploy:production": "npm run format:check && npm run check && npm run test && npm run build:production && npm run verify:dist && npm run test:e2e && npm run verify:production-config && npx wrangler deploy --dry-run && npx wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "cheerio": "^1.2.0",
    "cross-env": "^10.1.0",
    "decap-server": "^3.10.0",
    "happy-dom": "^20.11.6",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0",
    "yaml": "^2.9.0"
  }
}
