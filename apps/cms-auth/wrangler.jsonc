{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "game-site-cms-auth",
  "main": "src/index.ts",
  "tsconfig": "./tsconfig.json",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  // Test defaults. Production has a separate environment below.
  "vars": {
    "CMS_ADMIN_ORIGIN": "https://cms.example.test",
    "CMS_AUTH_ORIGIN": "https://cms-auth.example.test",
  },
  "observability": {
    "enabled": true,
    "logs": {
      // Fetch invocation URLs include OAuth code/state query parameters.
      "invocation_logs": false,
    },
    "traces": {
      "enabled": false,
    },
  },
  "env": {
    "production": {
      // GATE A placeholders. verify:production-config rejects .invalid.
      "vars": {
        "CMS_ADMIN_ORIGIN": "https://cms.placeholder.invalid",
        "CMS_AUTH_ORIGIN": "https://cms-auth.placeholder.invalid",
      },
      "observability": {
        "enabled": true,
        "logs": {
          "invocation_logs": false,
        },
        "traces": {
          "enabled": false,
        },
      },
    },
  },
}
