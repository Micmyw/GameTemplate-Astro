---
import AdSlot from "../components/ads/AdSlot.astro";
import GameCard from "../components/games/GameCard.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import { SITE } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPopulatedPublishedCategories } from "../lib/content/categories";
import { getFeaturedGames, getPublishedGames } from "../lib/content/games";
import { buildItemListJsonLd, buildWebSiteJsonLd } from "../lib/seo";

const games = await getPublishedGames();
const featuredGames = await getFeaturedGames(2);
const populatedCategories = await getPopulatedPublishedCategories();
const categories = populatedCategories.map(({ category }) => category);
const categoryNames = new Map(
  categories.map((category) => [category.id, category.data.name]),
);
const websiteJsonLd = buildWebSiteJsonLd();
const featuredGamesJsonLd = buildItemListJsonLd(
  featuredGames.map((game) => ({
    name: game.data.title,
    path: `/games/${game.id}/`,
  })),
);
---

<BaseLayout
  title={`${SITE.name} | Focused browser game guides`}
  description="Discover a focused collection of browser games with clear controls, mobile notes, and useful play guides."
  canonicalPath="/"
>
  <Fragment slot="head">
    <JsonLd data={websiteJsonLd} />
    {featuredGamesJsonLd && <JsonLd data={featuredGamesJsonLd} />}
  </Fragment>

  <section class="shell hero" aria-labelledby="page-title">
    <div class="hero-copy">
      <p class="eyebrow">Browser games, mapped clearly</p>
      <h1 id="page-title">Choose the next route, not the next distraction.</h1>
      <p class="hero-intro">
        Read the objective, controls, and device fit before opening a game.
        Every published route is static, focused, and written for that game.
      </p>
      <a class="button-link" href="/games/">Browse all games</a>
    </div>

    <div class="route-board" aria-hidden="true">
      <p>Catalogue route 01</p>
      <div class="route-line route-line-one"><span></span></div>
      <div class="route-line route-line-two"><span></span></div>
      <div class="route-line route-line-three"><span></span></div>
      <strong>{games.length} published games</strong>
    </div>
  </section>

  <section class="shell home-section" aria-labelledby="featured-heading">
    <div class="section-heading">
      <div>
        <p class="section-label">Start here</p>
        <h2 id="featured-heading">Featured games</h2>
      </div>
      <a class="text-link" href="/games/">View the full catalogue →</a>
    </div>
    <div class="game-grid">
      {
        featuredGames.map((game) => (
          <GameCard
            game={game}
            categoryNames={categoryNames}
            headingLevel="h3"
          />
        ))
      }
    </div>
    <AdSlot slot="home-after-featured" />
  </section>

  <section class="shell home-section" aria-labelledby="latest-heading">
    <div class="section-heading">
      <div>
        <p class="section-label">Recently published</p>
        <h2 id="latest-heading">Latest routes</h2>
      </div>
    </div>
    <ol class="latest-list">
      {
        games.slice(0, 3).map((game, index) => (
          <li>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <a href={`/games/${game.id}/`}>{game.data.title}</a>
            <p>{game.data.shortDescription}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="shell home-section" aria-labelledby="categories-heading">
    <div class="section-heading">
      <div>
        <p class="section-label">Browse by play style</p>
        <h2 id="categories-heading">Featured categories</h2>
      </div>
    </div>
    <div class="category-grid">
      {
        categories
          .filter((category) => category.data.featured)
          .map((category) => (
            <a class="category-card" href={`/category/${category.id}/`}>
              <span>{String(category.data.order).padStart(2, "0")}</span>
              <strong>{category.data.name}</strong>
              <p>{category.data.shortDescription}</p>
            </a>
          ))
      }
    </div>
  </section>
</BaseLayout>
