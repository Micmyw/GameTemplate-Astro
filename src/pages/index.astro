---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Discover a focused collection of browser games with clear controls and useful play guides."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>GameSite | Handpicked browser games</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href="/" aria-label="GameSite home">
          <span aria-hidden="true">GS</span>
          GameSite
        </a>
        <span class="build-label">Foundation preview</span>
      </div>
    </header>

    <main>
      <section class="shell hero" aria-labelledby="page-title">
        <div class="hero-copy">
          <p class="eyebrow">Browser games, clearly explained</p>
          <h1 id="page-title">Find a game worth your next break.</h1>
          <p class="hero-intro">
            GameSite is being built as a focused library of quick-to-start
            browser games, with practical details before you press play.
          </p>
          <a class="text-link" href="#site-foundation">
            See what is taking shape
            <span aria-hidden="true">↓</span>
          </a>
        </div>

        <div class="game-window" aria-hidden="true">
          <div class="window-bar">
            <span></span><span></span><span></span>
            <p>play / discover / return</p>
          </div>
          <div class="window-stage">
            <span class="track track-one"></span>
            <span class="track track-two"></span>
            <span class="player-marker"></span>
            <p>New routes are loading</p>
          </div>
        </div>
      </section>

      <section class="shell foundation" id="site-foundation">
        <p class="section-label">The starting point</p>
        <div class="foundation-grid">
          <h2>A small, durable foundation before the catalogue grows.</h2>
          <div>
            <p>
              This first release establishes fast static pages, accessible
              navigation, and a deployment path built for reliable browsing.
            </p>
            <p class="next-note">
              Game pages and categories arrive in the next reviewed release.
            </p>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <span>GameSite</span>
        <span>Static by design.</span>
      </div>
    </footer>
  </body>
</html>
