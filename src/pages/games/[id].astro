---
import { render, type CollectionEntry } from "astro:content";

import GameControls from "../../components/games/GameControls.astro";
import GamePlayer from "../../components/games/GamePlayer.astro";
import RelatedGames from "../../components/games/RelatedGames.astro";
import JsonLd from "../../components/seo/JsonLd.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPopulatedPublishedCategories } from "../../lib/content/categories";
import { getPublishedGames } from "../../lib/content/games";
import { rankRelatedGames } from "../../lib/related-games";
import { buildBreadcrumbJsonLd, buildGameJsonLd } from "../../lib/seo";

export async function getStaticPaths() {
  const games = await getPublishedGames();

  return games.map((game) => ({ params: { id: game.id }, props: { game } }));
}

type Props = {
  game: CollectionEntry<"games">;
};

const { game } = Astro.props;
const { Content } = await render(game);
const categories = (await getPopulatedPublishedCategories()).map(
  ({ category }) => category,
);
const categoryNames = new Map(
  categories.map((category) => [category.id, category.data.name]),
);
const relatedGames = rankRelatedGames(game, await getPublishedGames());
const pagePath = `/games/${game.id}/`;
const gameJsonLd = buildGameJsonLd(game, categories);
const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: "Home", path: "/" },
  { name: "Games", path: "/games/" },
  { name: game.data.title, path: pagePath },
]);
---

<BaseLayout
  title={game.data.seoTitle}
  description={game.data.seoDescription}
  canonicalPath={pagePath}
  image={game.data.coverImage}
  ogType="article"
>
  <Fragment slot="head">
    <JsonLd data={gameJsonLd} />
    <JsonLd data={breadcrumbJsonLd} />
  </Fragment>

  <article class="shell game-detail">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/games/">Games</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{game.data.title}</span>
    </nav>

    <header class="game-detail-header">
      <div>
        <p class="eyebrow">Playable route profile</p>
        <h1>{game.data.title}</h1>
        <p class="lede">{game.data.shortDescription}</p>
        <div class="tag-row" aria-label="Game tags">
          {game.data.tags.map((tag) => <span>{tag}</span>)}
        </div>
      </div>
    </header>

    <GamePlayer
      title={game.data.title}
      embedUrl={game.data.embedUrl}
      coverImage={game.data.coverImage}
      coverAlt={game.data.coverAlt}
      loadMode={game.data.loadMode}
      aspectRatio={game.data.aspectRatio}
    />

    <div class="game-info-strip" aria-label="Game information">
      <div><span>Mobile</span><strong>{game.data.mobileSupport}</strong></div>
      <div>
        <span>Orientation</span><strong>{game.data.orientation}</strong>
      </div>
      <div>
        <span>Categories</span>
        <div>
          {
            game.data.categories.map((category) => (
              <a href={`/category/${category.id}/`}>
                {categoryNames.get(category.id) ?? category.id}
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <section class="detail-section game-copy" aria-labelledby="guide-heading">
      <p class="section-label">Play guide</p>
      <h2 id="guide-heading">How this game works</h2>
      <div class="prose"><Content /></div>
    </section>

    <GameControls controls={game.data.controls} />
    <RelatedGames games={relatedGames} categoryNames={categoryNames} />
  </article>
</BaseLayout>
