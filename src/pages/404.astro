---
import { SITE } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title={`Page not found | ${SITE.name}`}
  description={`The requested ${SITE.name} route could not be found.`}
  canonicalPath="/404.html"
  robots="noindex, follow"
>
  <section class="shell error-page">
    <div class="error-code" aria-hidden="true">404</div>
    <div class="error-copy">
      <p class="eyebrow">This route ends here</p>
      <h1>That page could not be found.</h1>
      <p>
        The address may have changed, or the game may not have joined the
        catalogue yet.
      </p>
      <nav aria-label="404 recovery links">
        <a class="button-link" href="/">Return home</a>
        <a class="text-link" href="/games/">Browse all games</a>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .error-page {
    display: grid;
    min-height: calc(100vh - 9rem);
    place-items: center;
    gap: clamp(2rem, 7vw, 6rem);
    padding-block: 4rem;
  }

  .error-code {
    color: var(--color-accent);
    font-family: var(--font-utility);
    font-size: clamp(7rem, 28vw, 17rem);
    font-weight: 800;
    letter-spacing: -0.12em;
    line-height: 0.75;
    opacity: 0.12;
  }

  .error-copy {
    max-width: 38rem;
  }

  .error-copy h1 {
    max-width: 11ch;
  }

  .error-copy nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  @media (min-width: 48rem) {
    .error-page {
      grid-template-columns: minmax(15rem, 0.8fr) minmax(0, 1fr);
    }
  }
</style>
