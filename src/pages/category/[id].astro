---
import type { CollectionEntry } from "astro:content";

import AdSlot from "../../components/ads/AdSlot.astro";
import GameCard from "../../components/games/GameCard.astro";
import JsonLd from "../../components/seo/JsonLd.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPopulatedPublishedCategories } from "../../lib/content/categories";
import {
  buildBreadcrumbJsonLd,
  buildCollectionPageJsonLd,
  buildItemListJsonLd,
} from "../../lib/seo";

export async function getStaticPaths() {
  const categories = await getPopulatedPublishedCategories();

  return categories.map(({ category, games }) => ({
    params: { id: category.id },
    props: { category, games },
  }));
}

type Props = {
  category: CollectionEntry<"categories">;
  games: CollectionEntry<"games">[];
};

const { category, games } = Astro.props;
const categoryNames = new Map(
  (await getPopulatedPublishedCategories()).map(({ category: entry }) => [
    entry.id,
    entry.data.name,
  ]),
);
const pagePath = `/category/${category.id}/`;
const collectionPageJsonLd = buildCollectionPageJsonLd({
  name: category.data.name,
  description: category.data.seoDescription,
  path: pagePath,
});
const itemListJsonLd = buildItemListJsonLd(
  games.map((game) => ({
    name: game.data.title,
    path: `/games/${game.id}/`,
  })),
);
const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: "Home", path: "/" },
  { name: category.data.name, path: pagePath },
]);
---

<BaseLayout
  title={category.data.seoTitle}
  description={category.data.seoDescription}
  canonicalPath={pagePath}
>
  <Fragment slot="head">
    <JsonLd data={collectionPageJsonLd} />
    {itemListJsonLd && <JsonLd data={itemListJsonLd} />}
    <JsonLd data={breadcrumbJsonLd} />
  </Fragment>

  <header class="shell page-hero category-hero">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{category.data.name}</span>
    </nav>
    <p class="eyebrow">Category route</p>
    <h1>{category.data.name}</h1>
    <p>{category.data.shortDescription}</p>
  </header>

  <section
    class="shell catalogue-section"
    aria-label={`${category.data.name} games`}
  >
    <div class="section-heading">
      <p class="section-label">Published in this category</p>
      <p>{games.length} games</p>
    </div>
    <div class="game-grid">
      {
        games.map((game) => (
          <GameCard game={game} categoryNames={categoryNames} />
        ))
      }
    </div>
    <AdSlot slot="category-after-grid" />
  </section>
</BaseLayout>
