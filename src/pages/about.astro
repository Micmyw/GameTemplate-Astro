---
import { SITE } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title={`About this game catalogue | ${SITE.name}`}
  description={`Learn how ${SITE.name} organizes focused browser game guides and keeps published pages useful before a game starts.`}
  canonicalPath="/about/"
>
  <article class="shell text-page">
    <header>
      <p class="eyebrow">About the catalogue</p>
      <h1>Useful context before play begins.</h1>
      <p class="lede">
        {SITE.name} is a small, editorially organized catalogue for browser games.
        Each published route explains the objective, controls, and device fit directly
        on the page.
      </p>
    </header>

    <section>
      <h2>Why the catalogue is selective</h2>
      <p>
        A shorter list makes it possible to write distinct guides and verify
        every route. Draft entries stay private until their content and play
        details are ready for publication.
      </p>
    </section>

    <section>
      <h2>What is available now</h2>
      <p>
        This release includes static game guides, category pages, and a game
        player that loads the separate game Origin only after you choose Play.
        The guide and controls remain readable before the game loads.
      </p>
      <a class="button-link" href="/games/">Browse the published games</a>
    </section>
  </article>
</BaseLayout>
